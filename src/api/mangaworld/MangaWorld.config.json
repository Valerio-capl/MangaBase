{
  "name": "MangaWorld",
  "baseUrl": "https://www.mangaworld.mx",
  "lang": "it",
  "selectors": {
    "search": {
      "resultCard": ".entry",
      "title": ".name, h3, .title",
      "url": "a",
      "cover": "img"
    },
    "manga": {
      "title": "h1.name",
      "cover": ".comic-info img",
      "info": ".meta-data .col-12",
      "label": "span, strong, b, i",
      "chapter": ".chapter",
      "chapterDate": ".text-muted"
    },
    "chapter": {
      "pageSelect": "select.page, select#page-select, .page-link select",
      "images": [
        "#reader img",
        "#page img",
        ".reader-content img",
        "img.img-fluid"
      ]
    }
  }
}