{
  "name": "MangaWorld",
  "baseUrl": "https://www.mangaworld.me",
  "lang": "it",
  "selectors": {
    "search": {
      "resultCard": ".archive-card",
      "title": ".card-title a, .card-title",
      "url": ".card-title a, a.card-cover",
      "cover": ".card-cover img, img"
    },
    "manga": {
      "title": "h1.manga-title",
      "cover": ".manga-cover img",
      "description": ".manga-plot",
      "info": ".manga-facts > div",
      "label": "dt",
      "chapter": "#panel-capitoli .ch-row",
      "chapterDate": ".ch-date"
    },
    "chapter": {
      "pageSelect": ".reader-progress button",
      "images": [
        ".reader-stage img.reader-page",
        "img[data-reader-image]"
      ]
    }
  }
}