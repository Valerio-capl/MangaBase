, "src/app/_layout.tsx", "src/app/(tabs)/searchScreen.tsx", "src/app/(tabs)/optionScreen.tsx", "src/app/(tabs)/libraryScreen.tsx", "src/app/(tabs)/_layout.tsx"  ]
